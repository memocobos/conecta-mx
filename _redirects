# Conecta Reynosa — Routing
# Las URLs limpias (/rol, /pagos, etc.) sirven el HTML correspondiente.
# Cualquier otra URL cae al catchall `/* → /index.html` y el JS de index.html
# detecta el ID del evento desde window.location.pathname (ver IIFE "Deep link").

# Páginas dedicadas (URL limpia → .html). Sin estas reglas, /rol daría 404.
/rol         /rol.html         200
/pagos       /pagos.html       200
/kamehouse   /kamehouse.html   200
/faq         /faq.html         200
/funciona    /funciona.html    200
/kit         /kit.html         200
/diseno      /diseno.html      200
/recibos     /recibos_v6.html  200
/demo        /demo.html        200
/demo-full   /demo-full.html   200
/contrato    /contrato.html    200

# Portal de clientes (Fase 2.1 — Supabase Auth)
/portal      /portal.html      200
/portal/*    /portal.html      200

# [PN27] Preventa a ciegas Pa'l Norte 2027: la URL del copy (/palnorte27) es un
# 301 a la ficha real (/palnorte). El deep link del index casa por id EXACTO
# (pase 1), así que sin esta regla /palnorte27 caería a la portada en silencio.
/palnorte27  /palnorte  301
# [NSQK-PREVENTA-1] La URL corta del anuncio de NSQK, misma razón que /palnorte27.
/nsqk  /nsqkmty  301

# Archivos especiales (Netlify los sirve directo si existen — protección extra)
/robots.txt  /robots.txt       200
/sitemap.xml /sitemap.xml      200
/manifest.json /manifest.json  200
/sw.js       /sw.js            200

# Catchall: cualquier otra URL (eventos como /karolg, /brunomars, etc.)
# carga index.html y el JS detecta el evento por pathname.
/*           /index.html       200
